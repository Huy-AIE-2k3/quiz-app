{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": {
    "name": "Mathrix",
    "theme": "Emerald Precision",
    "archetype": "Modern Academic Technical Assessment (Math & CS)"
  },
  "color": {
    "light": {
      "bg": {
        "canvas": "#F8FAFC",
        "surface": "#FFFFFF",
        "elevated": "#F1F5F9",
        "subtleAccent": "#ECFDF5"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "muted": "#94A3B8"
      },
      "border": {
        "subtle": "#E2E8F0",
        "strong": "#CBD5E1",
        "accent": "#059669"
      },
      "brand": {
        "primary": "#059669",
        "hover": "#047857",
        "glow": "rgba(5, 150, 105, 0.12)"
      },
      "status": {
        "correct": {
          "bg": "#ECFDF5",
          "border": "#10B981",
          "text": "#065F46"
        },
        "wrong": {
          "bg": "#FEF2F2",
          "border": "#EF4444",
          "text": "#991B1B"
        },
        "flag": {
          "bg": "#FFFBEB",
          "border": "#F59E0B",
          "text": "#92400E"
        }
      },
      "timer": {
        "normal": {
          "text": "#065F46",
          "border": "#10B981",
          "bg": "#ECFDF5",
          "dot": "#059669",
          "label": "Bình thường"
        },
        "warning": {
          "text": "#92400E",
          "border": "#F59E0B",
          "bg": "#FFFBEB",
          "dot": "#D97706",
          "label": "Sắp hết giờ"
        },
        "critical": {
          "text": "#991B1B",
          "border": "#EF4444",
          "bg": "#FEF2F2",
          "dot": "#DC2626",
          "label": "Khẩn cấp"
        }
      }
    },
    "dark": {
      "bg": {
        "canvas": "#090D16",
        "surface": "#111726",
        "elevated": "#1A2234",
        "subtleAccent": "rgba(16, 185, 129, 0.10)"
      },
      "text": {
        "primary": "#F1F5F9",
        "secondary": "#94A3B8",
        "muted": "#64748B"
      },
      "border": {
        "subtle": "#1E293B",
        "strong": "#334155",
        "accent": "#10B981"
      },
      "brand": {
        "primary": "#10B981",
        "hover": "#34D399",
        "glow": "rgba(16, 185, 129, 0.18)"
      },
      "status": {
        "correct": {
          "bg": "rgba(16, 185, 129, 0.12)",
          "border": "#10B981",
          "text": "#6EE7B7"
        },
        "wrong": {
          "bg": "rgba(239, 68, 68, 0.12)",
          "border": "#EF4444",
          "text": "#FCA5A5"
        },
        "flag": {
          "bg": "rgba(245, 158, 11, 0.12)",
          "border": "#F59E0B",
          "text": "#FCD34D"
        }
      },
      "timer": {
        "normal": {
          "text": "#F1F5F9",
          "border": "#1E293B",
          "bg": "#1A2234",
          "dot": "#10B981",
          "label": "Bình thường"
        },
        "warning": {
          "text": "#FCD34D",
          "border": "#F59E0B",
          "bg": "rgba(245, 158, 11, 0.15)",
          "dot": "#F59E0B",
          "label": "Sắp hết giờ"
        },
        "critical": {
          "text": "#FCA5A5",
          "border": "#EF4444",
          "bg": "rgba(239, 68, 68, 0.20)",
          "dot": "#EF4444",
          "label": "Khẩn cấp"
        }
      }
    }
  },
  "typography": {
    "fonts": {
      "sans": "'Be Vietnam Pro', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
      "display": "'Space Grotesk', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace",
      "math": "'KaTeX_Main', 'Times New Roman', serif"
    },
    "sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "prose": "1.0625rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "lineHeights": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.625",
      "proseMath": "1.8"
    }
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px"
  },
  "shadow": {
    "none": "none",
    "subtle": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "glow": "0 0 12px rgba(16, 185, 129, 0.25)"
  },
  "layout": {
    "topbarHeight": "56px",
    "shortcutBarHeight": "36px",
    "containerMaxWidth": "1360px"
  }
}

