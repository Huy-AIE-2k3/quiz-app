# ==============================================================================
# HỆ THỐNG QUIZ TOÁN - TIN: BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================
# QUY TẮC BẢO MẬT:
# 1. Sao chép tệp này sang '.env' và điền các giá trị thực tế của bạn.
# 2. KHÔNG BAO GIỜ commit tệp '.env' chứa thông tin thật lên Git.
# 3. Tuyệt đối KHÔNG có tài khoản/mật khẩu mặc định nào được cấu hình sẵn tại đây.
# ==============================================================================

# Môi trường chạy: development | staging | production
APP_ENV=development
DEBUG=true

# Cấu hình container Docker Postgres cục bộ
POSTGRES_USER=quiz_user
POSTGRES_PASSWORD=YOUR_SECURE_LOCAL_DB_PASSWORD
POSTGRES_DB=quiz_dev
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@quiz.com
PGADMIN_DEFAULT_PASSWORD=Admin123!

# CSDL PostgreSQL (Local Docker hoặc Neon)
# Chuỗi kết nối ứng dụng (qua PgBouncer/Pooled nếu dùng Neon):
DATABASE_URL=postgresql://quiz_user:YOUR_SECURE_LOCAL_DB_PASSWORD@127.0.0.1:5432/quiz_dev
# Chuỗi kết nối trực tiếp (dành riêng cho Alembic migration):
DATABASE_URL_DIRECT=postgresql://quiz_user:YOUR_SECURE_LOCAL_DB_PASSWORD@127.0.0.1:5432/quiz_dev

# Bảo mật phiên & Mã hóa (Bắt buộc tạo chuỗi ngẫu nhiên dài >= 32 ký tự)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
SESSION_TTL_HOURS=12

# Lưu trữ tệp S3-Compatible (MinIO local hoặc Cloudflare R2)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=quiz-files
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_REGION=auto

# CORS (Danh sách origin được phép, phân tách bằng dấu phẩy)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Cấu hình tải lên
MAX_UPLOAD_MB=10

# Cấu hình lưu trữ dữ liệu (Số ngày giữ bài thi đã đóng/lưu trữ trước khi dọn)
DATA_RETENTION_DAYS=90
