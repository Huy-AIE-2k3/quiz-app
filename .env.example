# ==============================================================================
# MATHRIX SYSTEM CONFIGURATION (.env)
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=True
APP_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & Authentication
# Secret key for JWT/opaque token signatures (Change in production!)
SECRET_KEY=mathrix-super-secure-dev-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Local Container)
POSTGRES_USER=quiz_user
POSTGRES_PASSWORD=quiz_password
POSTGRES_DB=quiz_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quiz_user:quiz_password@localhost:5432/quiz_db

# pgAdmin 4 Web Console (Docker Container)
PGADMIN_DEFAULT_EMAIL=admin@mathrix.edu.vn
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# S3 / Cloudflare R2 Storage (Optional for local dev)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=quiz-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
